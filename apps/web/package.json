{
  "name": "@atesta/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/assistant-index.ts && next dev",
    "build": "node scripts/assistant-index.ts && next build && node node_modules/@atesta/ui/scripts/csp.ts && node scripts/security-txt.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . ../../packages/ui",
    "test": "vitest run",
    "check-licenses": "pnpm licenses list --json | node scripts/check-licenses.ts",
    "check-legal": "node scripts/check-legal.ts",
    "check-landing": "node scripts/check-landing.ts",
    "gen:api": "node scripts/gen-api-types.ts"
  },
  "dependencies": {
    "@atesta/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "js-yaml": "4.3.2",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
