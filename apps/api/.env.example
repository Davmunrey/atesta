# Local development against devtools/fake_cognito.py. No secrets here: generate
# ATESTA_SESSION_KEY yourself (see devtools/README.md). Never use these values in AWS.
ATESTA_ENV=local
ATESTA_DATABASE_URL=postgresql+psycopg://atesta_app:local-only@localhost:5432/postgres
ATESTA_DB_SSLMODE=disable
# Optional catalog preview only: owner-capable credentials for a loopback atesta_dev database.
# Set this separately before running devtools.preview_catalog --import; never use production.
# ATESTA_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/atesta_dev
ATESTA_COGNITO_REGION=eu-south-2
ATESTA_COGNITO_USER_POOL_ID=local
ATESTA_COGNITO_APP_CLIENT_ID=local-web
ATESTA_COGNITO_DOMAIN=localhost:9000
ATESTA_COGNITO_ISSUER=http://localhost:9000
ATESTA_COGNITO_BASE_URL=http://localhost:9000
ATESTA_WEB_ORIGIN=http://localhost:3000
ATESTA_WEB_BASE_URL=http://localhost:3000
# Evidence file uploads (evidence-file-uploads spec): a local folder, development only.
# Without these two lines uploads are disabled and the API still starts.
# ATESTA_EVIDENCE_STORE=local
# ATESTA_EVIDENCE_STORE_DIR=/absolute/path/outside/the/repo
