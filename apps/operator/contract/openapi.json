          }
        },
        "required": [
          "email",
          "role"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "StaffRole": {
        "enum": [
          "admin",
          "billing",
          "support"
        ],
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
